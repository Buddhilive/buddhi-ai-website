---
import config from "@/config/config.json" assert { type: "json" };
import { markdownify } from "@/lib/utils/textConverter";
import { getTranslations } from "@/lib/utils/languagePerser";
import { withBaseUrl } from "@/lib/utils/withBaseUrl";

const locale = Astro.currentLocale;

const menu = await getTranslations(locale || "en");

const footer = menu.footer;
---

<footer>
  <div class="container">
    <div class="top-footer">
      {
        footer.community && (
          <div>
            <h4>{footer.community.title}</h4>
            <ul>
              {footer.community?.links.map((link: any) => (
                <li>
                  <a href={withBaseUrl(link.url, import.meta.env.BASE_URL)}
                    >{link.name}</a
                  >
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.help_links && (
          <div>
            <h4>{footer.help_links.title}</h4>
            <ul>
              {footer.help_links?.links.map((link: any) => (
                <li>
                  <a href={withBaseUrl(link.url, import.meta.env.BASE_URL)}
                    >{link.name}</a
                  >
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        footer.company && (
          <div>
            <h4>{footer.company.title}</h4>
            <ul>
              {footer.company?.links.map((link: any) => (
                <li>
                  <a href={withBaseUrl(link.url, import.meta.env.BASE_URL)}
                    >{link.name}</a
                  >
                </li>
              ))}
            </ul>
          </div>
        )
      }

    </div>
    <div class="bottom-footer">
      <p set:html={markdownify(config?.params?.copyright)} />
      <a href={withBaseUrl("/privacy-policy/", import.meta.env.BASE_URL)}
        >{Astro.locals.t("footer.privacy", "Privacy Policy")}</a
      >
    </div>
  </div>
</footer>

<style>
  @layer starlight.core {
    .top-footer {
      border-bottom: 1px solid var(--sl-color-gray-6);
      padding: 60px 0;
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .top-footer h4 {
      font-size: 1rem !important;
      margin-bottom: 4rem;
    }
    .top-footer ul {
      list-style: none;
      padding: 0;
    }
    .top-footer ul li {
      margin-bottom: 1.2rem;
    }
    .top-footer ul li a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      color: var(--sl-color-text);
      text-decoration: none;
      font-size: 1rem;
      transition: color 0.3s ease;
    }
    .top-footer ul li a:hover {
      color: var(--color-primary);
    }
    .bottom-footer {
      padding: 32px 0;
      border-top: 1px solid var(--sl-color-hairline);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .bottom-footer a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      color: var(--sl-color-text);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .bottom-footer a:hover {
      color: var(--color-primary);
    }
  }
</style>
